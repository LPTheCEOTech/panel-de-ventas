# Las TRES unicas variables de entorno de esta app.
#
# Todo lo demas (nombre del negocio, moneda, zona horaria, color de marca)
# vive en la tabla `configuracion` y se edita desde Ajustes. Es a proposito:
# cada variable que hay que pegar a mano en Vercel es una chance mas de pegar
# los caracteres invisibles del valor enmascarado y quedarse con una app rota
# que no dice por que.
#
# 🔴 Copialas con "Reveal" / "Copy", NUNCA seleccionando el texto con puntitos.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
